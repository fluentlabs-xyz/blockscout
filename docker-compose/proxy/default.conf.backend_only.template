# WebSocket upgrade helper
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# CORS allowlist (regex). Define via env in docker-compose/.env:
#   PUBLIC_HOST=devnet.fluentscan.xyz
#   CORS_ALLOWED_ORIGIN_REGEX=^https://blockscout-frontend-topaz\.vercel\.app$
# Or multiple:
#   CORS_ALLOWED_ORIGIN_REGEX=^https://(blockscout-frontend-topaz\.vercel\.app|explorer\.fluentscan\.xyz)$
map $http_origin $cors_origin {
    default "";
    ~*${CORS_ALLOWED_ORIGIN_REGEX} $http_origin;
}

server {
    listen 80;
    server_name ${PUBLIC_HOST};
    proxy_http_version 1.1;

    # Security/behavior (optional but sane defaults)
    server_tokens off;

    # =========================
    # Stats API (proxy -> stats)
    # =========================
    location ~ ^/(api/v1/counters|api/v1/lines|api/v1/pages/main|api/v1/pages/transactions|api/v1/pages/contracts|api/v1/charts/batch-update) {
        # Ensure we control CORS (don't forward upstream CORS)
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Allow-Credentials;

        # CORS headers live at location level (NOT inside if)
        add_header 'Access-Control-Allow-Origin' "$cors_origin" always;
        add_header 'Vary' 'Origin' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, X-Requested-With' always;
        add_header 'Access-Control-Max-Age' 86400 always;

        # Preflight: only return; no add_header here
        if ($request_method = OPTIONS) {
            return 204;
        }

        proxy_pass http://stats:8050;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cache_bypass $http_upgrade;
    }

    # =========================
    # Backend API / WS / Auth
    # =========================
    location ~ ^/(api(?!-docs$)|socket|sitemap\.xml|auth/auth0|auth/auth0/callback|auth/logout) {
        proxy_buffer_size       128k;
        proxy_buffers           8 256k;
        proxy_busy_buffers_size 512k;

        proxy_pass ${BACK_PROXY_PASS};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cache_bypass $http_upgrade;
    }

    # =========================
    # Frontend (optional)
    # =========================
    # location / {
    #     proxy_pass ${FRONT_PROXY_PASS};
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection $connection_upgrade;
    #     proxy_cache_bypass $http_upgrade;
    # }
}

server {
    listen 8080;
    server_name ${PUBLIC_HOST};
    proxy_http_version 1.1;
    server_tokens off;

    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Allow-Credentials;

    add_header 'Access-Control-Allow-Origin' "$cors_origin" always;
    add_header 'Vary' 'Origin' always;
    add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
    add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, X-Requested-With' always;
    add_header 'Access-Control-Max-Age' 86400 always;

    if ($request_method = OPTIONS) {
        return 204;
    }

    location / {
        proxy_pass http://stats:8050/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cache_bypass $http_upgrade;
    }
}

server {
    listen 8081;
    server_name ${PUBLIC_HOST};
    proxy_http_version 1.1;
    server_tokens off;

    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Allow-Credentials;

    add_header 'Access-Control-Allow-Origin' "$cors_origin" always;
    add_header 'Vary' 'Origin' always;
    add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
    add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, X-Requested-With' always;
    add_header 'Access-Control-Max-Age' 86400 always;

    if ($request_method = OPTIONS) {
        return 204;
    }

    location / {
        proxy_pass http://visualizer:8050/;
        proxy_buffering off;
        proxy_connect_timeout 30m;
        proxy_read_timeout 30m;
        proxy_send_timeout 30m;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cache_bypass $http_upgrade;
    }
}

server {
    listen 9091;
    server_name ${PUBLIC_HOST};
    proxy_http_version 1.1;
    server_tokens off;

    location ~ ^/(metrics|public-metrics)$ {
        proxy_pass ${BACK_PROXY_PASS};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 404;
    }
}
